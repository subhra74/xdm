        <!-- Conscrypt (BoringSSL) as the JSSE provider; installed at startup by AppMain. The uber jar
             bundles natives for linux-x86_64/aarch64, osx-x86_64/aarch64 and windows-x86_64. -->
        <dependency>
            <groupId>org.conscrypt</groupId>
            <artifactId>conscrypt-openjdk-uber</artifactId>
            <version>2.7.0</version>
        </dependency>

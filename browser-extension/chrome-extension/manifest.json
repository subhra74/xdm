{
    "default_locale": "en",
    "name": "__MSG_extName__",
    "action": {
        "default_title": "__MSG_extName__",
        "default_icon": {
            "16": "icon16-mono.png",
            "48": "icon48-mono.png",
            "128": "icon128-mono.png"
        }
    },
    "manifest_version": 3,
    "version": "3.5",
    "description": "__MSG_extDesc__",
    "homepage_url": "https://github.com/subhra74/xdm",
    "minimum_chrome_version": "103",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "cookies",
        "webRequest",
        "storage",
        "contextMenus",
        "alarms",
        "scripting"
    ],
    "commands": {
        "open-bulk": {
            "suggested_key": {
                "default": "Alt+Shift+D"
            },
            "description": "__MSG_command_open_bulk__"
        }
    },
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}

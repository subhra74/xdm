{
    "name": "XDM v8+ Browser Helper",
    "browser_action": {
        "default_title": "XDM v8+ Browser Helper",
        "default_icon": {
            "16": "icon16-mono.png",
            "48": "icon48-mono.png",
            "128": "icon128-mono.png"
        }
    },
    "manifest_version": 2,
    "version": "1.5",
    "description": "Download files with XDM v8+",
    "permissions": [
        "tabs",
        "cookies",
        "menus",
        "webRequest",
        "webRequestBlocking",
        "*://*/*"
    ],
    "background": {
        "page": "main.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "xdm-v8-browser-helper@subhra74.github.io",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
